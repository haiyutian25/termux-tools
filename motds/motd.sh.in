#!@TERMUX_PREFIX@/bin/bash

# Setup TERMUX_APP_PACKAGE_MANAGER
source "@TERMUX_PREFIX@/bin/termux-setup-package-manager" || exit 1

terminal_width="$(stty size | cut -d" " -f2)"
if [[ "$terminal_width" =~ ^[0-9]+$ ]] && [ "$terminal_width" -gt 60 ]; then

    motd="
 \e[47m                \e[0m  \e[1mTermux 版本：\e[0m ${TERMUX_VERSION-Unknown}
"

    motd_indent="                   "

else

    motd="
\e[1mTermux 版本：\e[0m ${TERMUX_VERSION-Unknown}
"

    motd_indent=""
fi

motd+="
${motd_indent}\e[1m软件包管理：\e[0m
${motd_indent}\e[1m搜索：\e[0m  pkg search <查询>
${motd_indent}\e[1m安装：\e[0m  pkg install <软件包>
${motd_indent}\e[1m升级：\e[0m  pkg upgrade
"


if [ "$TERMUX_APP_PACKAGE_MANAGER" = "apt" ]; then

    motd+="
${motd_indent}\e[1m订阅额外的软件仓库：\e[0m
${motd_indent}\e[1mRoot：\e[0m pkg install root-repo
${motd_indent}\e[1mX11：\e[0m  pkg install x11-repo

${motd_indent}如需修复软件仓库问题，
${motd_indent}请尝试 'termux-change-repo' 命令。
"

fi

echo -e "$motd"
